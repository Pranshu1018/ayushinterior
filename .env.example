# Google Apps Script web app URL (see docs/lead-webhook.gs). Leads are only logged to the console if unset.
PUBLIC_LEAD_WEBHOOK=
# Google Analytics 4 measurement ID, e.g. G-XXXXXXX (optional)
PUBLIC_GA_ID=
# Google Search Console "HTML tag" verification: paste only the content="..." value
PUBLIC_GSC_VERIFICATION=
# Bing Webmaster Tools verification: paste only the content="..." value of msvalidate.01
PUBLIC_BING_VERIFICATION=
