---
import Base from '../../layouts/Base.astro';
import InnerHeader from '../../components/InnerHeader.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import Icon from '../../components/Icon.astro';
import Quote from '../../components/sections/Quote.astro';
import Footer from '../../components/sections/Footer.astro';
import { site, wa, img } from '../../data/site';
import { areaPages, getService, type AreaPage } from '../../data/pages';
import { projects, testimonials } from '../../data/content';
import { breadcrumbSchema, faqSchema, serviceSchema } from '../../lib/schema';

export function getStaticPaths() {
  return areaPages.map((a) => ({ params: { slug: a.slug }, props: { a } }));
}
const { a } = Astro.props as { a: AreaPage };
const place = `${a.name}, ${site.city}`;
const crumbs = [{ name: 'Home', href: '/' }, { name: 'Areas', href: '/interior-designers' }, { name: a.name, href: `/interior-designers/${a.slug}` }];
const focus = a.focus.map(getService);
const nearbyLinks = a.nearby.map((n) => ({ n, page: areaPages.find((p) => p.name === n) }));
const faqs = [
  { q: `Do you offer free site visits in ${a.name}?`, a: `Yes. A designer visits your home in ${a.name} (${a.pin}) free of charge to measure, understand your needs and discuss options, usually within 48 hours of your call.` },
  { q: `How much do 2 BHK interiors cost in ${a.name}?`, a: `Most 2 BHK interiors in ${a.name} range from ₹4.5L to ₹9L depending on scope and finishes. Single jobs like a modular kitchen start from ₹1.6L. You get an itemised written quote before any work begins.` },
  { q: `How long does a project in ${a.name} take?`, a: `Modular kitchens take 15–25 days, bathrooms 10–14 days and full 2–3 BHK interiors 45–60 days from design approval. We follow your society’s working hours and rules.` },
  { q: `Which areas near ${a.name} do you cover?`, a: `We work across ${site.city}, including ${a.nearby.join(', ')} and every other node from Airoli to Panvel and Ulwe.` },
];
const schema = [
  serviceSchema({ name: `Interior design and renovation in ${place}`, description: a.about, url: `/interior-designers/${a.slug}`, area: { '@type': 'Place', name: place, address: { '@type': 'PostalAddress', addressLocality: a.name, addressRegion: site.state, postalCode: a.pin, addressCountry: 'IN' } } }),
  breadcrumbSchema(crumbs),
  faqSchema(faqs),
];
const story = testimonials[areaPages.indexOf(a) % testimonials.length];
---
<Base
  title={`Interior Designers in ${a.name}, Navi Mumbai | Ayush Interior`}
  description={`Interior designers in ${a.name} (${a.pin}), Navi Mumbai: ${focus.slice(0, 2).map((f) => f.name.toLowerCase()).join(', ')} and full home interiors. Free site visit and written quote.`}
  schema={schema} preloader={false} quoteHref="#quote"
>
  <InnerHeader />

  <section class="pb-14 pt-8 md:pb-20 md:pt-12">
    <div class="wrap">
      <Breadcrumbs items={crumbs} />
      <p class="label mt-8 flex items-center gap-2"><Icon name="pin" size={14} /> {a.name} · {a.pin}</p>
      <h1 class="giant mt-4 !text-[clamp(2.5rem,6.4vw,6.6rem)]">Interior Designers<br /><span class="text-grey">in {a.name}, Navi Mumbai</span></h1>
      <div class="mt-10 grid gap-8 md:grid-cols-[27%_1fr] md:gap-0">
        <div class="flex flex-col gap-3">
          <a href="#quote" class="pill pill-dark w-full max-w-[17rem]">Free site visit <span class="dot"><Icon name="arrow" size={17} /></span></a>
          <a href={wa(`Hi ${site.name}, I need interiors for my home in ${a.name}.`)} target="_blank" rel="noopener" data-track="click_whatsapp" class="pill w-full max-w-[17rem]">WhatsApp us <span class="dot !bg-whatsapp !text-white"><Icon name="whatsapp" size={17} /></span></a>
        </div>
        <p class="max-w-3xl text-[clamp(1.2rem,1.9vw,1.6rem)] font-medium leading-[1.3] tracking-[-0.03em]">{a.about}</p>
      </div>
    </div>
  </section>

  <section class="py-14 md:py-20">
    <div class="wrap">
      <div class="rule"></div>
      <div class="grid gap-6 pt-5 md:grid-cols-[27%_1fr] md:gap-0">
        <div><p class="label">Popular in {a.name}</p><p class="sublabel mt-3">What homeowners here ask us for most</p></div>
        <h2 class="display md:pt-6">Services:</h2>
      </div>
      <div class="mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
        {focus.map((f, i) => (
          <a href={`/services/${f.slug}`} class="group block" data-reveal style={`--d:${i * 70}ms`}>
            <div class="overflow-hidden rounded-[10px]"><img src={img(f.img, 600, 700)} alt={`${f.name} in ${a.name}`} loading="lazy" width="600" height="700" class="aspect-[6/7] w-full object-cover transition duration-1000 group-hover:scale-105" /></div>
            <h3 class="mt-3 text-[1.25rem] font-semibold tracking-[-0.04em]">{f.name} in {a.name}</h3>
            <p class="text-[0.85rem] text-grey">From {f.prices[0].range.split('–')[0].trim()}</p>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="bg-dark py-14 text-white md:py-20">
    <div class="wrap grid gap-10 md:grid-cols-[27%_1fr] md:gap-0">
      <p class="label">Why {a.name} homeowners choose us</p>
      <ul class="grid gap-6 sm:grid-cols-2">
        {[
          ['Designer visits within 48 hours', `Free measurement and consultation at your home in ${a.name}.`],
          ['Written, itemised quote', 'Every material, brand and rupee listed before work starts.'],
          ['Society-friendly work', 'We follow society rules, timings and paperwork, and clean up daily.'],
          ['10-year woodwork warranty', 'In writing, with staged payments and GST invoices.'],
        ].map(([t, b]) => <li><p class="text-[1.3rem] font-semibold tracking-[-0.035em]">{t}</p><p class="mt-2 text-[0.95rem] text-white/60">{b}</p></li>)}
      </ul>
    </div>
  </section>

  <section class="py-14 md:py-20">
    <div class="wrap grid gap-10 md:grid-cols-[27%_1fr] md:gap-0">
      <div><div class="rule mb-5"></div><p class="label">Recent projects</p><p class="sublabel mt-3">Work across Navi Mumbai</p></div>
      <div>
        <div class="rule mb-8 hidden md:block"></div>
        <div class="grid gap-5 sm:grid-cols-3">
          {projects.slice(0, 3).map((p) => (
            <article>
              <img src={img(p.img, 600, 700)} alt={`${p.name}, ${p.type} in ${p.place}`} loading="lazy" width="600" height="700" class="aspect-[6/7] w-full rounded-[10px] object-cover" />
              <h3 class="mt-3 text-[1.15rem] font-semibold tracking-[-0.04em]">{p.name}</h3>
              <p class="text-[0.8rem] text-grey">{p.type} · {p.place}</p>
            </article>
          ))}
        </div>
        <blockquote class="mt-12 max-w-3xl text-[clamp(1.3rem,2.2vw,2rem)] font-semibold leading-[1.15] tracking-[-0.04em]">“{story.quote}”<footer class="mt-4 text-[0.85rem] font-medium tracking-normal text-grey">{story.name} · {story.home}</footer></blockquote>
      </div>
    </div>
  </section>

  <section class="py-14 md:py-20">
    <div class="wrap grid gap-10 md:grid-cols-[27%_1fr] md:gap-0">
      <div><div class="rule mb-5"></div><p class="label">{a.name} FAQ</p></div>
      <div>
        <div class="rule mb-2 hidden md:block"></div>
        <div class="divide-y divide-line border-b border-line">
          {faqs.map((f, i) => (
            <details class="group" open={i === 0}>
              <summary class="flex cursor-pointer list-none items-center justify-between gap-6 py-5 text-[1.15rem] font-semibold tracking-[-0.03em] [&::-webkit-details-marker]:hidden">
                <h3>{f.q}</h3><span class="grid size-9 shrink-0 place-items-center rounded-full transition group-open:rotate-45 group-open:bg-yellow"><Icon name="plus" size={20} /></span>
              </summary>
              <p class="pb-6 pr-12 leading-relaxed text-grey">{f.a}</p>
            </details>
          ))}
        </div>
        <p class="mt-10 label">Nearby areas</p>
        <ul class="mt-3 flex flex-wrap gap-2">
          {nearbyLinks.map(({ n, page }) => page
            ? <li><a href={`/interior-designers/${page.slug}`} class="inline-block rounded-full border border-line bg-white px-4 py-2 text-[0.9rem] font-semibold transition hover:border-ink">{n}</a></li>
            : <li class="rounded-full border border-dashed border-line px-4 py-2 text-[0.9rem] font-semibold text-grey">{n}</li>)}
        </ul>
      </div>
    </div>
  </section>

  <Quote area={a.name} />
  <Footer />
</Base>
