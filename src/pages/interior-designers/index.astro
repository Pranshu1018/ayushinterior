---
import Base from '../../layouts/Base.astro';
import InnerHeader from '../../components/InnerHeader.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import Icon from '../../components/Icon.astro';
import Quote from '../../components/sections/Quote.astro';
import Footer from '../../components/sections/Footer.astro';
import { site } from '../../data/site';
import { areaPages } from '../../data/pages';
import { breadcrumbSchema } from '../../lib/schema';
const crumbs = [{ name: 'Home', href: '/' }, { name: 'Areas', href: '/interior-designers' }];
const others = site.localities.filter((l) => !areaPages.some((a) => a.name === l));
---
<Base
  title={`Interior Designers Across Navi Mumbai | Ayush Interiors`}
  description={`Ayush Interiors designs and renovates homes across Navi Mumbai: Vashi, Nerul, Seawoods, Belapur, Kharghar, Airoli, Panvel, Ulwe and more. Free site visit.`}
  schema={[breadcrumbSchema(crumbs)]} preloader={false} quoteHref="#quote"
>
  <InnerHeader />
  <section class="pb-16 pt-8 md:pb-24 md:pt-12">
    <div class="wrap">
      <Breadcrumbs items={crumbs} />
      <p class="label mt-8">Areas we serve</p>
      <h1 class="display mt-4 max-w-4xl">Interior designers across Navi Mumbai:</h1>
      <p class="mt-5 max-w-2xl text-[1.08rem] leading-relaxed text-grey">From Airoli in the north to Panvel and Ulwe in the south, a designer can usually visit your home within 48 hours.</p>
      <ul class="mt-12 divide-y divide-line border-y border-line">
        {areaPages.map((a, i) => (
          <li data-reveal style={`--d:${Math.min(i, 5) * 50}ms`}>
            <a href={`/interior-designers/${a.slug}`} class="group grid grid-cols-[1fr_auto] items-center gap-4 py-6 md:grid-cols-[27%_1fr_auto]">
              <span class="text-[clamp(1.6rem,3vw,2.8rem)] font-semibold leading-none tracking-[-0.05em] transition group-hover:translate-x-2">{a.name}</span>
              <span class="hidden text-[0.9rem] leading-snug text-grey md:block md:pr-10">{a.about.split('. ')[0]}.</span>
              <span class="grid size-11 place-items-center rounded-full border border-line transition group-hover:border-yellow group-hover:bg-yellow"><Icon name="arrow" size={18} /></span>
            </a>
          </li>
        ))}
      </ul>
      <p class="mt-10 text-[0.95rem] text-grey">We also work in {others.join(', ')} and nearby areas.</p>
    </div>
  </section>
  <Quote />
  <Footer />
</Base>
