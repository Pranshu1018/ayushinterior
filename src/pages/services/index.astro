---
import Base from '../../layouts/Base.astro';
import InnerHeader from '../../components/InnerHeader.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import Icon from '../../components/Icon.astro';
import Quote from '../../components/sections/Quote.astro';
import Footer from '../../components/sections/Footer.astro';
import { site, img } from '../../data/site';
import { servicePages } from '../../data/pages';
import { breadcrumbSchema } from '../../lib/schema';
const crumbs = [{ name: 'Home', href: '/' }, { name: 'Services', href: '/services' }];
---
<Base
  title={`Home Interior Services in ${site.city} | Ayush Interiors`}
  description={`Full home interiors, modular kitchens, wardrobes, false ceilings, bathrooms, painting and flooring in ${site.city}. See starting prices and get a free quote.`}
  schema={[breadcrumbSchema(crumbs)]} preloader={false} quoteHref="#quote"
>
  <InnerHeader />
  <section class="pb-10 pt-8 md:pt-12">
    <div class="wrap">
      <Breadcrumbs items={crumbs} />
      <p class="label mt-8">What we do</p>
      <h1 class="display mt-4 max-w-4xl">Interior design &amp; renovation services in {site.city}:</h1>
      <p class="mt-5 max-w-2xl text-[1.08rem] leading-relaxed text-grey">Every service is designed and executed by our own team, with a free site visit, an itemised written quote and staged payments.</p>
    </div>
  </section>
  <section class="pb-16 md:pb-24">
    <ul class="wrap grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {servicePages.map((s, i) => (
        <li data-reveal style={`--d:${(i % 3) * 70}ms`}>
          <a href={`/services/${s.slug}`} class="group block">
            <div class="overflow-hidden rounded-[12px]"><img src={img(s.img, 800, 600)} alt={`${s.name} in ${site.city}`} loading={i < 3 ? 'eager' : 'lazy'} width="800" height="600" class="aspect-[4/3] w-full object-cover transition duration-1000 group-hover:scale-105" /></div>
            <div class="mt-4 flex items-start justify-between gap-4">
              <div>
                <h2 class="text-[1.45rem] font-semibold tracking-[-0.04em]">{s.name}</h2>
                <p class="mt-1 text-[0.85rem] text-grey">From {s.prices[0].range.split('–')[0].trim()}</p>
              </div>
              <span class="grid size-10 shrink-0 place-items-center rounded-full border border-line transition group-hover:border-yellow group-hover:bg-yellow"><Icon name="arrow" size={17} /></span>
            </div>
          </a>
        </li>
      ))}
    </ul>
  </section>
  <Quote />
  <Footer />
</Base>
