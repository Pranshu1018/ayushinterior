---
import Logo from '../Logo.astro';
import { site, nav, img } from '../../data/site';
import { P } from '../../data/content';
import { servicePages, areaPages } from '../../data/pages';
---
<footer class="relative isolate overflow-hidden bg-dark pb-28 pt-14 text-white md:pb-10 md:pt-20">
  <img src={img(P.footer, 1800, 1000, 60)} alt="" loading="lazy" width="1800" height="1000" class="absolute inset-0 -z-10 size-full object-cover opacity-[0.22]" />
  <span aria-hidden="true" class="absolute left-[51%] top-0 hidden h-[62%] w-px bg-white/15 md:block"></span>
  <span aria-hidden="true" class="absolute left-[46%] top-[58%] hidden h-px w-[8%] bg-white/25 md:block"></span>

  <div class="wrap">
    <div class="grid gap-12 md:grid-cols-[1fr_1fr]">
      <div data-reveal>
        <a href="/" class="text-[1.1rem]"><Logo light /></a>
        <p class="mt-10 max-w-sm text-[clamp(1.3rem,1.9vw,1.7rem)] font-semibold leading-[1.15] tracking-[-0.035em]">We turn houses into homes <span class="text-beige">you'll love living in.</span></p>
      </div>
      <div class="grid grid-cols-2 gap-8 md:pl-[4%]" data-reveal style="--d:100ms">
        <nav aria-label="Footer">
          <ul class="space-y-1.5">
            {[{ label: 'Home', href: '/' }, ...nav].map((n) => <li><a href={n.href} class="text-[clamp(1.25rem,1.7vw,1.6rem)] font-semibold tracking-[-0.035em] transition hover:text-beige">{n.label}</a></li>)}
          </ul>
        </nav>
        <ul class="space-y-2 text-right text-[0.8rem] text-white/60">
          {Object.entries(site.social).map(([k, v]) => <li><a href={v} target="_blank" rel="noopener" class="hover:text-white">{k}</a></li>)}
        </ul>
      </div>
    </div>

    <div class="mt-16 grid gap-10 border-t border-white/10 pt-10 sm:grid-cols-2 md:grid-cols-[27%_1fr_1fr]">
      <p class="label text-white/50">Explore</p>
      <div>
        <p class="label text-white">Services</p>
        <ul class="mt-4 space-y-2 text-[0.9rem] text-white/65">
          {servicePages.map((s) => <li><a href={`/services/${s.slug}`} class="hover:text-white">{s.name} in {site.city}</a></li>)}
        </ul>
      </div>
      <div>
        <p class="label text-white">Interior designers in</p>
        <ul class="mt-4 grid grid-cols-2 gap-2 text-[0.9rem] text-white/65">
          {areaPages.map((a) => <li><a href={`/interior-designers/${a.slug}`} class="hover:text-white">{a.name}</a></li>)}
        </ul>
      </div>
    </div>

    <div class="mt-16 md:mt-24 md:pl-[27%]" data-reveal>
      <a href={site.phoneHref} data-track="click_call" class="text-[0.85rem] text-white/70 hover:text-white">{site.phone}</a>
    </div>
    <a href={`mailto:${site.email}`} class="mt-3 block text-[clamp(1.55rem,5.2vw,5.2rem)] font-semibold leading-none tracking-[-0.06em] transition [overflow-wrap:anywhere] hover:text-beige md:whitespace-nowrap md:pl-[27%]" data-reveal>{site.email}</a>

    <div class="mt-14 flex flex-col gap-6 border-t border-white/10 pt-6 text-[0.75rem] text-white/45 md:flex-row md:items-end md:justify-between">
      <p class="flex flex-wrap gap-x-8 gap-y-2"><span>© {new Date().getFullYear()} {site.legal}. All rights reserved</span><a href="/privacy" class="hover:text-white">Privacy policy</a><a href="/terms" class="hover:text-white">Terms of service</a></p>
      <address class="not-italic text-white/70 md:text-right">{site.addressLines.map((l) => <span class="block">{l}</span>)}<span class="block">{site.hours}</span></address>
    </div>
    <p class="mt-6 text-[0.7rem] leading-relaxed text-white/30">Serving {site.localities.join(' · ')}</p>
  </div>
</footer>
