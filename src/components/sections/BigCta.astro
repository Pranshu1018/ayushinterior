---
import Icon from '../Icon.astro';
import { img, srcset } from '../../data/site';
import { P } from '../../data/content';
---
<section class="cta relative isolate flex min-h-[78svh] items-end overflow-hidden bg-dark text-white">
  <img src={img(P.ctaDark, 1800, 1100)} srcset={srcset(P.ctaDark, [800, 1300, 1900], 0.62)} sizes="100vw" alt="" loading="lazy" width="1800" height="1100" class="cta-img absolute inset-0 -z-10 size-full object-cover" />
  <div aria-hidden="true" class="absolute inset-0 -z-10 bg-gradient-to-t from-black/75 via-black/30 to-black/40"></div>
  <span aria-hidden="true" class="absolute left-[27%] top-0 hidden h-full w-px bg-white/15 md:block"></span>

  <div class="w-full px-5 pb-14 md:px-8 md:pb-20">
    <p class="mb-5 text-[1.05rem] font-medium tracking-[-0.02em] text-white/85 md:pl-[27%]" data-reveal>Crafting homes<br /><span class="text-beige">that feel like you</span></p>
    <h2 class="giant !text-[clamp(2.4rem,7.6vw,8.6rem)]">
      <span class="mask" data-reveal-mask><span>It's so Easy to</span></span>
      <span class="mask md:pl-[calc(27%-2rem)]" data-reveal-mask style="--d:120ms"><span>Change <span class="cta-accent">your Home</span></span></span>
    </h2>
    <div class="mt-10 md:pl-[27%]" data-reveal style="--d:200ms">
      <a href="/#quote" class="pill pill-glass w-full max-w-[20rem]">Get a Free Quote <span class="dot"><Icon name="arrow" size={17} /></span></a>
    </div>
  </div>
</section>

<style>
  .cta-accent {
    background: linear-gradient(rgb(241 223 194 / 0.8), rgb(241 223 194 / 0.8)), url('https://images.unsplash.com/photo-1763392199003-27cee33bae31?auto=format&fit=crop&w=900&q=60') center / cover;
    -webkit-background-clip: text; background-clip: text; -webkit-text-fill-color: transparent;
  }
</style>

<script>
  // Slow zoom on the background as the section scrolls through
  const sec = document.querySelector<HTMLElement>('.cta');
  const im = sec?.querySelector<HTMLElement>('.cta-img');
  if (sec && im && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
    addEventListener('scroll', () => {
      const r = sec.getBoundingClientRect();
      const p = Math.min(1, Math.max(0, 1 - r.bottom / (innerHeight + r.height)));
      im.style.transform = `scale(${1.15 - p * 0.15})`;
    }, { passive: true });
  }
</script>
