---
import Logo from '../Logo.astro';
import Icon from '../Icon.astro';
import { site, img, srcset } from '../../data/site';
import { P } from '../../data/content';
const tags = ['Interior Design', 'Home Renovation', 'Modular Kitchens', 'Turnkey Execution'];
---
<section id="top" class="hero relative h-[100svh] min-h-[620px] overflow-hidden bg-[#b9ada0] text-white">
  <div class="hero-media absolute inset-0 -z-0">
    <img
      data-hero-img
      src={img(P.hero, 1800, 1100)}
      srcset={srcset(P.hero, [700, 1100, 1600, 2200], 0.62)}
      sizes="100vw"
      alt="Warm living room by Ayush Interior with curved sofa, fluted wood panelling and soft lighting"
      width="1800" height="1100" fetchpriority="high"
      class="size-full object-cover"
    />
  </div>
  <div aria-hidden="true" class="absolute inset-0 bg-[linear-gradient(180deg,rgb(0_0_0/0.28)_0%,rgb(0_0_0/0.05)_30%,rgb(0_0_0/0.08)_55%,rgb(0_0_0/0.45)_100%)]"></div>

  <!-- Guide lines -->
  <span aria-hidden="true" data-intro style="--i:2" class="hero-vline absolute left-[27%] top-[12%] hidden h-[52%] w-px bg-white/35 md:block"></span>
  <span aria-hidden="true" data-intro style="--i:3" class="hero-vline absolute left-[75%] top-[30%] hidden h-[38%] w-px bg-white/35 md:block"></span>
  <span aria-hidden="true" data-intro style="--i:4" class="absolute bottom-0 left-[27%] hidden h-[9%] w-px bg-white/35 md:block"></span>

  <!-- Top bar -->
  <header class="absolute inset-x-0 top-0 z-10">
    <div class="relative flex items-start justify-between px-5 pt-5 md:px-8 md:pt-6">
      <a href="/" data-intro style="--i:1" class="text-[1.05rem] md:text-[1.15rem]"><Logo light /></a>
      <div data-intro style="--i:2" class="absolute left-[27%] top-6 hidden text-[0.8rem] font-semibold leading-[1.35] md:block">
        <p>{site.city}, {site.state}</p>
        {site.addressLines.map((l) => <p>{l}</p>)}
      </div>
      <div data-intro style="--i:3" class="absolute left-[51%] top-6 hidden text-[0.8rem] font-semibold leading-[1.35] lg:block">
        <a href={`mailto:${site.email}`} class="block hover:underline">{site.email}</a>
        <a href={site.phoneHref} data-track="click_call" class="block hover:underline">{site.phone}</a>
      </div>
      <div data-intro style="--i:4" class="flex items-center gap-3 md:gap-5">
        <a href="#quote" class="pill pill-glass hidden !min-h-11 sm:inline-flex md:w-56">Get a Quote <span class="dot !size-8"><Icon name="arrow" size={16} /></span></a>
        <button type="button" data-menu-open class="grid size-11 place-items-center rounded-full text-white transition hover:bg-white/15" aria-label="Open menu"><Icon name="menu" size={26} /></button>
      </div>
    </div>
  </header>

  <!-- Middle clusters -->
  <div class="absolute inset-x-0 top-[24%] z-10 px-5 md:top-[22%] md:px-0">
    <div class="md:absolute md:left-[27%] md:pl-0">
      <a href={site.googleUrl} target="_blank" rel="noopener" data-intro style="--i:5" class="mb-8 hidden items-center gap-2 text-[0.7rem] font-semibold leading-tight md:inline-flex">
        <span class="grid size-9 place-items-center rounded-full bg-white text-ink"><span class="text-[0.95rem] font-bold">G</span></span>
        <span><span class="flex gap-0.5 text-yellow">{[1, 2, 3, 4, 5].map(() => <Icon name="star" size={11} />)}</span>Google rated {site.rating} · {site.reviews} reviews</span>
      </a>
      <p data-intro style="--i:6" class="text-[1.15rem] font-medium leading-tight tracking-[-0.03em] md:text-[1.35rem]">Interiors &amp; Renovation<br /><span class="text-beige">Since {site.founded}</span></p>
    </div>
    <ul data-intro style="--i:7" class="absolute left-[75%] top-[35%] hidden pl-4 text-[0.85rem] font-semibold leading-[1.5] md:block">
      {tags.map((t) => <li>{t}</li>)}
    </ul>
  </div>

  <!-- Headline -->
  <div class="absolute inset-x-0 bottom-[9%] z-10 px-5 md:bottom-[8%] md:px-8">
    <h1 class="giant !text-[clamp(2.4rem,7.6vw,8.6rem)]">
      <span class="sr-only">Ayush Interior: interior design and home renovation in {site.city}. </span>
      <span class="mask hero-line" style="--i:0"><span>Turning Houses</span></span>
      <span class="mask hero-line md:pl-[calc(27%-2rem)]" style="--i:1"><span>into <span class="hero-accent">Dream Homes</span></span></span>
    </h1>
    <a href="#quote" data-intro style="--i:8" class="pill mt-7 w-full max-w-[19rem] sm:hidden">Get a Free Quote <span class="dot"><Icon name="arrow" size={17} /></span></a>
  </div>

  <a href="#numbers" data-intro style="--i:9" class="absolute bottom-5 left-5 z-10 flex items-center gap-3 text-[0.75rem] font-semibold md:left-[calc(27%+1rem)] md:bottom-7">
    <span class="scroll-cue relative block h-9 w-px overflow-hidden bg-white/30"><span class="absolute inset-x-0 top-0 h-1/2 bg-white"></span></span>
    Scroll to explore
  </a>
</section>

<style>
  .hero-accent {
    color: var(--color-beige);
    background: linear-gradient(rgb(241 223 194 / 0.82), rgb(241 223 194 / 0.82)), url('https://images.unsplash.com/photo-1763392199003-27cee33bae31?auto=format&fit=crop&w=900&q=60') center / cover;
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
  }
  .scroll-cue span { animation: cue 1.8s var(--ease-hm) infinite; }
  @keyframes cue { from { transform: translateY(-100%); } to { transform: translateY(200%); } }

  /* Intro: hidden while the preloader runs, animated in when <html> gets .intro */
  :global(.js) .hero-media img { transform: scale(1.14); }
  :global(.js.intro) .hero-media img { transform: scale(1); transition: transform 2.4s var(--ease-out-hm); }
  :global(.js) .hero [data-intro] { opacity: 0; transform: translateY(18px); }
  :global(.js) .hero .hero-vline[data-intro] { transform: scaleY(0); transform-origin: top; opacity: 1; }
  :global(.js.intro) .hero [data-intro] { opacity: 1; transform: none; transition: opacity 0.9s var(--ease-out-hm), transform 1.1s var(--ease-out-hm); transition-delay: calc(0.35s + var(--i) * 70ms); }
  :global(.js) .hero-line > span { transform: translateY(108%); }
  :global(.js.intro) .hero-line > span { transform: none; transition: transform 1.25s var(--ease-out-hm); transition-delay: calc(var(--i) * 120ms); }
</style>

<script>
  // Gentle parallax on the hero photo while scrolling past it.
  const media = document.querySelector<HTMLElement>('.hero-media');
  if (media && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
    let ticking = false;
    addEventListener('scroll', () => {
      if (ticking) return; ticking = true;
      requestAnimationFrame(() => { const y = Math.min(scrollY, innerHeight); media.style.transform = `translate3d(0, ${y * 0.25}px, 0)`; ticking = false; });
    }, { passive: true });
  }
</script>
