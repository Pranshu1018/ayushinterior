---
interface Props { items: { name: string; href: string }[] }
const { items } = Astro.props;
---
<nav aria-label="Breadcrumb" class="text-[0.8rem] font-medium text-grey">
  <ol class="flex flex-wrap items-center gap-2">
    {items.map((it, i) => (
      <li class="flex items-center gap-2">
        {i < items.length - 1 ? <a href={it.href} class="transition hover:text-ink">{it.name}</a> : <span class="text-ink" aria-current="page">{it.name}</span>}
        {i < items.length - 1 && <span aria-hidden="true">/</span>}
      </li>
    ))}
  </ol>
</nav>
